{%- doc -%}
  Renders Tanishq-style 'Wedding' (Rivaah) mega menu matching Tanishq layout with high-resolution bridal imagery.
{%- enddoc -%}

<div class="tanishq-mega-menu tanishq-mega-menu--visual section section--full-width-margin section--{{ section.settings.section_width | default: 'page-width' }}">
  <div class="tanishq-mega-menu__container">
    
    <!-- 6-Column Grid Matching Tanishq Screenshot -->
    <div class="tanishq-visual-grid">
      
      <!-- Card 1: All Rivaah -->
      <a href="{{ routes.collections_url }}/wedding-collection" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-all-rivaah.jpg' | asset_url }}"
            alt="All Rivaah Wedding Jewellery"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">All Rivaah</span>
      </a>

      <!-- Card 2: Wedding Choker -->
      <a href="{{ routes.collections_url }}/wedding-collection" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-choker.jpg' | asset_url }}"
            alt="Wedding Choker"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Wedding Choker</span>
      </a>

      <!-- Card 3: Wedding Haram -->
      <a href="{{ routes.collections_url }}/wedding-collection" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-haram.jpg' | asset_url }}"
            alt="Wedding Haram"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Wedding Haram</span>
      </a>

      <!-- Card 4: Wedding Bangles -->
      <a href="{{ routes.collections_url }}/gold-jewelry/Bangles-(or-Bracelets)" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-bangles.jpg' | asset_url }}"
            alt="Wedding Bangles"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Wedding Bangles</span>
      </a>

      <!-- Card 5: Wedding Diamond -->
      <a href="{{ routes.collections_url }}/diamonds" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-diamond.jpg' | asset_url }}"
            alt="Wedding Diamond"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Wedding Diamond</span>
      </a>

      <!-- Card 6: Wedding Mangalsutra -->
      <a href="{{ routes.collections_url }}/gold-jewelry/Necklace-(or-Chain)" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-mangalsutra.jpg' | asset_url }}"
            alt="Wedding Mangalsutra"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Wedding Mangalsutra</span>
      </a>

      <!-- Card 7: Accessories (Row 2, Column 1) -->
      <a href="{{ routes.collections_url }}/wedding-collection" class="tanishq-visual-card">
        <div class="tanishq-visual-card__thumb">
          <img
            src="{{ 'wedding-accessories.jpg' | asset_url }}"
            alt="Wedding Accessories"
            class="tanishq-visual-card__img"
            loading="lazy"
            width="360"
            height="360"
          >
        </div>
        <span class="tanishq-visual-card__title">Accessories</span>
      </a>

    </div>

  </div>
</div>

<style>
  .tanishq-mega-menu--visual .tanishq-visual-grid {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 20px 24px !important;
    width: 100% !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-decoration: none !important;
    transition: transform 0.25s ease !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card:hover {
    transform: translateY(-4px) !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card__thumb {
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08) !important;
    border: 1px solid #ECE5DA !important;
    background: #FAF8F5 !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.35s ease !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card:hover .tanishq-visual-card__img {
    transform: scale(1.06) !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card__title {
    font-family: var(--font-body--family, sans-serif) !important;
    font-size: 0.92rem !important;
    font-weight: 500 !important;
    color: #161312 !important;
    margin-top: 10px !important;
    text-align: center !important;
    line-height: 1.3 !important;
    transition: color 0.15s ease !important;
  }

  .tanishq-mega-menu--visual .tanishq-visual-card:hover .tanishq-visual-card__title {
    color: #58111A !important;
    font-weight: 600 !important;
  }

  @media screen and (max-width: 1100px) {
    .tanishq-mega-menu--visual .tanishq-visual-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  @media screen and (max-width: 600px) {
    .tanishq-mega-menu--visual .tanishq-visual-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>
