{%- doc -%}
  Renders Tanishq-style luxury 'Diamonds' mega menu with visual category cards,
  automatic Shopify collection image integration, and comprehensive subcategories.
{%- enddoc -%}

<div class="tanishq-mega-menu section section--full-width-margin section--{{ section.settings.section_width | default: 'page-width' }}">
  <div class="tanishq-mega-menu__container">

    <div class="tanishq-mega-menu__columns" style="grid-template-columns: 1.1fr 1.5fr 1.3fr 1.4fr;">
      
      <!-- Men's Diamond Column -->
      <div class="tanishq-mega-col">
        <div class="tanishq-col__heading">
          <span class="tanishq-col__heading-icon">👔</span>
          <span class="tanishq-col__heading-text">Men's Diamonds</span>
        </div>
        <ul class="tanishq-col__list list-unstyled">
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link tanishq-col__link--all">All Men's Diamonds</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Rings</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Bracelets</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Earrings</a></li>
        </ul>
      </div>

      <!-- Women's Diamond Column -->
      <div class="tanishq-mega-col">
        <div class="tanishq-col__heading">
          <span class="tanishq-col__heading-icon">✨</span>
          <span class="tanishq-col__heading-text">Women's Diamonds</span>
        </div>
        <ul class="tanishq-col__list list-unstyled">
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link tanishq-col__link--all">All Women's Diamonds</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Earrings</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Necklace</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Pendants</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Bangles</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Rings</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Necklaces</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Bracelets</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Mangalsutra</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Nose Pin</a></li>
        </ul>
      </div>

      <!-- Kids & Teens Column -->
      <div class="tanishq-mega-col">
        <div class="tanishq-col__heading">
          <span class="tanishq-col__heading-icon">⭐</span>
          <span class="tanishq-col__heading-text">Kids &amp; Teens</span>
        </div>
        <ul class="tanishq-col__list list-unstyled">
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link tanishq-col__link--all">All Kids &amp; Teens</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Earrings</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Diamond Pendants</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Bangles</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Rings</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Bracelets</a></li>
          <li><a href="{{ routes.collections_url }}/diamonds" class="tanishq-col__link">Nose Pin</a></li>
        </ul>
      </div>

      <!-- Featured Diamond Card -->
      <div class="tanishq-mega-col tanishq-mega-col--featured">
        <div class="tanishq-featured-card">
          <div class="tanishq-featured-card__badge">SGL / IGI Certified</div>
          <h4 class="tanishq-featured-card__title">Natural Certified Diamonds</h4>
          <p class="tanishq-featured-card__desc">Flawless cut, brilliant fire, and ethical sourcing in 14K &amp; 18K hallmarked gold.</p>
          <a href="{{ routes.collections_url }}/diamonds" class="tanishq-featured-card__btn button button--primary">
            Explore All Diamonds
          </a>
          <div class="tanishq-trust-markers">
            <span class="tanishq-trust-item">✦ 100% Conflict-Free Natural Diamonds</span>
            <span class="tanishq-trust-item">✦ Lifetime Exchange Guarantee</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
